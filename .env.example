# Neon Postgres pooled connection string, e.g.
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Optional: without it the public site serves the bundled default content and
# the admin dashboard reports "기본 콘텐츠 사용 중".
DATABASE_URL=

# Admin credentials for /admin/login.
# When both are set they take priority (and are required in production).
# If they are left unset in development, the admin area falls back to
# admin@korun.co.kr / korun-dev-admin so the login flow can be used locally.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signing key for the admin session cookie (32+ characters recommended).
# Required in production; falls back to ADMIN_PASSWORD, then to a
# development-only constant outside production.
ADMIN_SESSION_SECRET=

# Vercel Blob read/write token used by the admin image upload endpoint.
BLOB_READ_WRITE_TOKEN=
